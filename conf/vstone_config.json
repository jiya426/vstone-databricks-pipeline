      "reconciliation_table": "silver_conformed_reconciliation",
      "long_cluster_by": [
        "level",
        "metric_name",
        "date_key"
      ]
    },
    "reference_rules": {
      "_comment": "Crosswalk cleaning rules (standardised names): zero-padding restores codes that lost leading zeros",
      "county_crosswalk": {
        "key": [
          "fips"
        ],
        "pad": {
          "fips": 5,
          "state_fips": 2,
          "county_fips": 3
        },
        "upper": []
      },
      "city_crosswalk": {
        "key": [
          "unique_city_id"
        ],
        "pad": {},
        "upper": [
          "state"
        ]
      }
    }
  },
