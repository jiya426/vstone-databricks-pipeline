  "benchmark": {
    "_comment": "Day 7 layout benchmark (PDF R33/R34): the Gold fact copied 3 ways, the same queries timed on each.",
    "results_table": "performance_benchmark",
    "layouts": {
      "plain": {
        "table": "bench_fact_plain",
        "ddl": "",
        "optimize": ""
      },
      "partition_zorder": {
        "table": "bench_fact_partition_zorder",
        "ddl": "PARTITIONED BY (metric_key)",
        "optimize": "ZORDER BY (region_key, date_key)"
      },
      "liquid": {
        "table": "bench_fact_liquid",
        "ddl": "CLUSTER BY (metric_key, region_key, date_key)",
        "optimize": ""
      }
    },
    "queries": [
      {
        "id": "Q1",
        "description": "One region, one metric, all months (point lookup)",
        "sql": "SELECT date_key, metric_value FROM {table} WHERE region_key = 'zip:01001' AND metric_key = 'zhvi_all_homes'"
      },
      {
        "id": "Q2",
        "description": "One metric, one month, all regions",
        "sql": "SELECT COUNT(*), AVG(metric_value) FROM {table} WHERE metric_key = 'zri_all_homes' AND date_key = 20171231"
      },
      {
        "id": "Q3",
        "description": "One metric, 3-year range, yearly average",
        "sql": "SELECT CAST(date_key / 10000 AS INT) AS year, AVG(metric_value) FROM {table} WHERE metric_key = 'zhvi_all_homes' AND date_key BETWEEN 20150101 AND 20171231 GROUP BY 1"
      },
      {
        "id": "Q4",
        "description": "All metrics of the state level for one month",
        "sql": "SELECT metric_key, COUNT(*) FROM {table} WHERE region_key LIKE 'state:%' AND date_key = 20171231 GROUP BY metric_key"
      },
      {
        "id": "Q5",
        "description": "Full scan aggregate (no filter - baseline)",
        "sql": "SELECT metric_key, COUNT(*) FROM {table} GROUP BY metric_key"
      }
    ]
  },
  "security": {
    "_comment": "Day 8-9 tiered access model. Groups are created once in Settings -> Identity and access -> Groups (Free Edition has no SCIM/account console); everything else is generated from this block by 08b_security_setup. One policy decision point: fn_access_level() returns the caller's level; every row filter and column mask uses it.",
    "levels": {
      "admin": {
        "rank": 1,
        "row_scope": "all",
        "description": "Data engineering: every row, exact values, lineage visible"
      },
      "analyst": {
        "rank": 2,
        "row_scope": "mapped_states",
        "description": "Regional analysts: only their states, money rounded to 1,000, lineage redacted"
      },
      "viewer": {
        "rank": 3,
        "row_scope": "all",
        "description": "Business viewers: all states at coarse precision - money rounded to 10,000, growth hidden, ZIP generalised"
      },
      "none": {
        "rank": 9,
        "row_scope": "none",
        "description": "Anyone not in a Vstone group: no rows"
      }
    },
    "admin_group": "vstone_admins",
    "groups": {
      "vstone_admins": {
        "level": "admin",
        "description": "Data engineering team"
      },
      "vstone_analysts_west": {
        "level": "analyst",
        "description": "Analysts for the western states"
      },
      "vstone_analysts_east": {
        "level": "analyst",
        "description": "Analysts for the eastern states"
      },
      "vstone_viewers": {
        "level": "viewer",
        "description": "Business viewers (management dashboards)"
      }
    },
    "state_access": {
      "vstone_analysts_west": [
        "CA",
        "OR",
        "WA",
        "NV",
        "AZ"
      ],
      "vstone_analysts_east": [
        "NY",
        "NJ",
        "MA",
        "PA",
        "FL"
      ]
    },
    "functions": {
      "access_level": "fn_access_level",
      "row_filter": "rf_state_access",
      "mask_prefix": "mask_"
    },
    "mask_rules": {
      "_comment": "SQL expression per level; `value` is the column value. A column mask returns the expression for the caller's level.",
      "usd": {
        "type": "DOUBLE",
        "sensitivity": "confidential",
        "description": "Money: exact for admins, rounded to 1,000 for analysts and 10,000 for viewers",
        "admin": "value",
        "analyst": "round(value, -3)",
        "viewer": "round(value, -4)",
        "none": "CAST(NULL AS DOUBLE)"
      },
      "pct": {
        "type": "DOUBLE",
        "sensitivity": "restricted",
        "description": "Growth percentages: hidden from viewers",
        "admin": "value",
        "analyst": "value",
        "viewer": "CAST(NULL AS DOUBLE)",
        "none": "CAST(NULL AS DOUBLE)"
      },
      "zip": {
        "type": "STRING",
        "sensitivity": "quasi_identifier",
        "description": "ZIP code: generalised to the 3-digit area for viewers",
        "admin": "value",
        "analyst": "value",
        "viewer": "concat(substr(value, 1, 3), '**')",
        "none": "CAST(NULL AS STRING)"
      },
      "internal": {
        "type": "STRING",
        "sensitivity": "internal",
        "description": "Lineage (file paths, run ids): admins only",
        "admin": "value",
        "analyst": "'REDACTED'",
        "viewer": "'REDACTED'",
        "none": "CAST(NULL AS STRING)"
      }
    },
    "access_table": "state_access_map",
    "policy_catalog_table": "access_policy_catalog",
