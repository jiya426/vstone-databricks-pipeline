      "state": "US state (plus the national United States series)",
      "metro": "Metropolitan statistical area (CBSA)",
      "county": "US county, identified by its 5-digit FIPS code",
      "city": "City, identified by Zillow's unique city id",
      "neighborhood": "Neighborhood, identified by Zillow's region id",
      "zip": "5-digit ZIP code"
