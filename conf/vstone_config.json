      "statuses": [
        "active",
        "cooling",
        "inactive"
      ]
    },
    "min_month_coverage": 0.5,
    "_comment_min_month_coverage": "'Latest month' of a level = the latest month reported by at least this share of the level's regions, so a few early (late-arriving) rows do not become the ranking month."
  },
  "late_arriving": {
    "_comment": "Day 7 incremental-load scenario. The Zillow extract ends in Dec 2017, so a late-arriving batch is SIMULATED from real rows: the latest month of region_count ZIP codes is revised by revision_pct and the next month arrives as new rows. Flagged by source = late_source in every layer.",
    "volume": "late_arriving",
    "file_prefix": "zillow_late_arriving",
    "bronze_table": "zillow_ts_late_arriving",
    "late_source": "autoloader_late_csv",
