    "metric_code": "ZHVI_AllHomes",
    "region_count": 100,
    "revision_pct": 1.0,
    "new_month_growth_pct": 0.5,
    "scd2_demo": {
      "_comment": "Crosswalk correction for the SCD Type 2 demo (simulated). MERGE changes one county name in Silver; the next Gold update closes the old dim_region version and opens a new one. A later full Silver rebuild restores the source name, which SCD2 records as a further version.",
      "crosswalk": "county_crosswalk",
      "key_column": "fips",
      "key_value": "01003",
      "column": "county_name",
      "suffix": " County"
    }
